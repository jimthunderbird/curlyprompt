objective: perform the following tasks

restrictions: DO NOT perform tasks that are marked as completed, after a task is completed, in ./init.prompt, mark the task as completed

task.import_japn_knowledge (completed) {
  txt_files: run cli command: find ~/airesearch/japan_knowledge/knowledge/japan/youtube_transcript/ -type f -name "*.txt" -depth 1
  youtube_video_hashes: for all the txt_files, extract all the youtube video ids 
  save youtube_video_hashes into ./japan.knowledge.youtube_video_hashes
}

group: generate_tags.py {
  task (completed) {
    create ./generate_tags.py:
    logic:
    - tags: examine all files in ./tags
    - titles: execulte command "find youtube_transcript/*.title"
      for each {title} in {titles} {
        youtube_video_hash: youtube_video_hash_related_to_{title}
        for each {tag} in {tags} {
          if {youtube_video_hash} does not exist in ./tags/{tag} {
            use ollama local model ornith:35b to find out if {youtube_video_hash} is related to {tag}
            if yes {
              append youtube_video_hash_related_to_{title} to ./tags/{tag} with new line at the end 
            }
          }
        }
      }  
  }

  task (completed) {
    add a new flag --youtube_video_hash <youtube_video_hash>
    logic:
    - tags: examine all files in ./tags
    for each {tag} in {tags} {
      if {youtube_video_hash} does not exist in ./tags/{tag} {
        use ollama local model ornith:35b to find out if {youtube_video_hash} is related to {tag}
        if yes {
          append youtube_video_hash_related_to_{title} to ./tags/{tag} with new line at the end 
        }
      }
    }
  }
}

